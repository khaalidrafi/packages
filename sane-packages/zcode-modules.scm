    "apps/zcode-cli/packages/adapters"
    "apps/zcode-cli/packages/shared-types"
    "apps/zcode-cli/packages/core"
    "apps/zcode-cli/packages/dynamic-workflow-runtime"
    "apps/zcode-cli/packages/i18n"
    "packages/provider-node"
    "apps/zcode-cli/packages/telemetry"
    "packages/formal-proof"
    "apps/zcode-cli/packages/bootstrap"
    "apps/zcode-cli/packages/tui"
    "apps/zcode-cli/packages/cli"))

(define %zcode-workspace-build-scripts
  ;; Each package's `build' script, run with bash -c from inside
  ;; that package's directory.
  (list
    (list "packages/model-option-map" "tsc")
    (list "apps/zcode-cli/packages/contracts" "tsc")
    (list "apps/zcode-cli/packages/dynamic-workflow" "node scripts/generate-libs.mjs && tsc")
    (list "packages/provider" "tsc")
    (list "apps/zcode-cli/packages/adapters" "tsc")
    (list "apps/zcode-cli/packages/shared-types" "tsc")
    (list "apps/zcode-cli/packages/core" "tsc")
    (list "apps/zcode-cli/packages/dynamic-workflow-runtime" "tsc")
    (list "apps/zcode-cli/packages/i18n" "tsc")
    (list "packages/provider-node" "tsc")
    (list "apps/zcode-cli/packages/telemetry" "tsc")
    (list "packages/formal-proof" "vite build")
    (list "apps/zcode-cli/packages/bootstrap" "tsc")
    (list "apps/zcode-cli/packages/tui" "tsc && node scripts/build.mjs")
    (list "apps/zcode-cli/packages/cli" "node scripts/build.mjs")))

(define %zcode-node-install-plan
  ;; install-path -> input label, which is all the builder needs.
  (map (match-lambda
         ((name version digest path) (list path (zcode-input-name path))))
       %zcode-node-modules))

(define %zcode-node-inputs
  ;; One labelled origin per install path.
  (map (match-lambda
         ((name version digest path)
          (list (zcode-input-name path)
                (zcode-npm-origin name version digest))))
       %zcode-node-modules))
