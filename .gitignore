# Guile byte-compiled files
*.go
*.scm.go

# `guix build' result symlink
result
result-*

# Downloaded sources, kept out of the tree by convention
*.deb

# Python bytecode from the generator scripts
__pycache__/
*.pyc

# Substitute publishing artifacts (tests/publish-substitutes.sh).  The bake
# cache and the static mirror are regenerated each CI run; never commit them.
.substitute-cache/
.substitute-site/
# CI handoff files: built store paths, and the recorded build exit status.
built-paths.txt
.build-status
