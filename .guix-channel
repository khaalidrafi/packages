;; This file is best viewed as -*- Scheme -*-.

;; Read by `guix pull' through (guix channels) -> read-channel-metadata.  Two
;; consequences worth knowing before you touch this repository:
;;
;; 1. There is no (directory ...) field, so the *root* of the repo is Guile's
;;    module load path.  `guix pull' compiles every `.scm' file it finds with
;;    `find-files', which means a stray non-module `.scm' anywhere in the tree
;;    (a manifest, a snippet, an example channels file) makes the pull of
;;    every user fail.  tests/check-static.sh enforces this; do not rely on
;;    noticing it later.
;; 2. (dependencies ...) is fetched automatically, so users only ever add
;;    `sane-packages' to ~/.config/guix/channels.scm: nonguix's
;;    (nonguix licenses) resolves for zcode.scm without a second entry.

(channel
  (version 0)
  (news-file "news.txt")
  (url "https://github.com/khaalidrafi/packages") ;the primary URL
  (dependencies (channel
                  (name nonguix)
                  (version 0)
                  (url "https://gitlab.com/nonguix/nonguix")
                  (channel-introduction (commit
                                         "897c1a470da759236cc11798f4e0a5f7d4d59fbc")
                                        (signer
                                         "2A39 3FFF 68F4 EF7A 3D29  12AF 6F51 20A0 22FB B2D5")))))
